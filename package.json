{
  "name": "liderweb-app",
  "version": "1.0.0",
  "description": "LiderWeb — App Android/iOS (Capacitor)",
  "private": true,
  "scripts": {
    "setup": "npm install && npx cap add android && npx cap sync",
    "sync": "npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "build:android": "npx cap sync android && cd android && ./gradlew assembleRelease",
    "build:aab": "npx cap sync android && cd android && ./gradlew bundleRelease",
    "run:android": "npx cap run android",
    "run:livereload": "npx cap run android --livereload --external"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/keyboard": "^6.0.3",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/network": "^6.0.3",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/push-notifications": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.2",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "typescript": "^5.4.5"
  }
}
